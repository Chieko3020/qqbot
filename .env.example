# QQ Bot 环境变量模板 — 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，严禁提交）
# 密钥只通过环境变量注入，禁止硬编码进源码

# QQ 开放平台机器人凭据（必填）
QQ_APP_ID=
QQ_APP_SECRET=

# DeepSeek 访问密钥（走 ai-gateway 时可留空）
DEEPSEEK_KEY=

# 监听与上游（默认值即生产配置，通常无需改动）
LISTEN_HOST=127.0.0.1
LISTEN_PORT=4001
DEEPSEEK_URL=http://127.0.0.1:4000/v1/chat/completions

# 日志级别: DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
